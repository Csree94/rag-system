# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.rds.neon.tech/database?sslmode=require

# Embedding Configuration
# Option 1: Gemini Embedding 2 (used by the retrieval and chat pipelines)
EMBEDDING_MODEL=gemini
EMBEDDING_MODEL_NAME=gemini-embedding-2
EMBEDDING_DIMENSION=768
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: OpenRouter (needs API key)
# EMBEDDING_MODEL=openrouter
# OPENROUTER_API_KEY=your_api_key_here
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# Option 3: sentence-transformers (runs locally, no API key needed)
# EMBEDDING_MODEL=sentence-transformers
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# For development/testing without external services:
# EMBEDDING_MODEL=simple-hash

# Gemini LLM (answer generation) - reuses GEMINI_API_KEY above
# GEMINI_LLM_MODEL=gemini-3.8-flash
# GEMINI_LLM_TEMPERATURE=0.2
# GEMINI_LLM_MAX_OUTPUT_TOKENS=1024

# RAG pipeline defaults
# RAG_TOP_K=5
# RAG_MIN_SIMILARITY=0.3
# RAG_MAX_CONTEXT_CHARS=12000

# JWT Authentication
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
