# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.rds.neon.tech/database?sslmode=require

# Embedding Configuration
# Option 1: Use sentence-transformers (runs locally, no API key needed)
# This downloads a model on first use (~90MB)
EMBEDDING_MODEL=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Option 2: Use OpenRouter (needs API key)
# EMBEDDING_MODEL=openrouter
# OPENROUTER_API_KEY=your_api_key_here
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# For development/testing without external services:
# EMBEDDING_MODEL=simple-hash

# JWT Authentication
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
