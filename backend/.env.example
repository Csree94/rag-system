# =============================================
# RAG System Backend - Environment Configuration
# Google AI Stack (Gemini + Google Embeddings)
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:password@host.rds.neon.tech/database?sslmode=require

# --- Google AI API ---
# Get your API key from https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# --- Google Embedding Model ---
# Current Google embedding model (768-dimensional vectors)
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# Embedding dimension must match the model.
# text-embedding-004 = 768
GOOGLE_EMBEDDING_DIMENSION=768

# --- Google Gemini LLM Model ---
# Current fast Gemini model
GOOGLE_GEMINI_MODEL=gemini-2.0-flash

# --- Chunking Configuration ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval Configuration ---
TOP_K=5

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
