# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.rds.neon.tech/database?sslmode=require

# Embedding Configuration
# Option 1: Use sentence-transformers (runs locally)
EMBEDDING_MODEL=sentence-transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Option 2: Use OpenRouter (needs API key)
# EMBEDDING_MODEL=openrouter
# OPENROUTER_API_KEY=your_api_key_here
# EMBEDDING_MODEL_NAME=text-embedding-3-small

# For development/testing without external services:
# EMBEDDING_MODEL=simple-hash
